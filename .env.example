# Copy this file to .env and fill in your own values
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
NEWS_REFRESH_MINUTES=30
CRON_SECRET=replace-with-a-random-refresh-secret

# Production deployment settings for Vercel/Postgres
# Vercel Postgres commonly exposes POSTGRES_URL (and sometimes POSTGRES_PRISMA_URL)
# You can set either one; the app accepts both.
DATABASE_URL=postgres://user:password@host:5432/dbname
POSTGRES_URL=postgres://user:password@host:5432/dbname
