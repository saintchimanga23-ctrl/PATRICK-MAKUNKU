<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · NewsHub</title>
  <meta name="description" content="NewsHub is a news aggregator that groups coverage of the same story from left, center, and right-leaning sources so you can see the full picture.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
